rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string &&
             id.size() >= 1 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.fullName is string &&
             data.fullName.size() >= 2 &&
             data.fullName.size() <= 80 &&
             data.username is string &&
             data.username.size() >= 3 &&
             data.username.size() <= 30 &&
             data.username.matches('^[a-zA-Z0-9_.]+$') &&
             data.email is string &&
             data.email.size() >= 3 &&
             data.email.size() <= 120 &&
             data.occupation is string &&
             data.occupation.size() <= 60 &&
             data.city is string &&
             data.city.size() <= 60 &&
             data.loginCount is int &&
             data.loginCount >= 1 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time &&
             data.lastLoginAt is timestamp &&
             data.lastLoginAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'fullName', 'username', 'email',
                         'occupation', 'city', 'loginCount',
                         'createdAt', 'updatedAt', 'lastLoginAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'fullName', 'username', 'email',
                         'occupation', 'city', 'loginCount',
                         'createdAt', 'updatedAt', 'lastLoginAt'
                       ]) &&
                       incoming().loginCount == 1 &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Edit profile fields
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'fullName', 'username', 'occupation', 'city', 'updatedAt'
                         ]) ||
                         // Action 2: Record login session
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'lastLoginAt', 'updatedAt', 'loginCount'
                           ]) &&
                           incoming().loginCount == existing().loginCount + 1
                         )
                       );

      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
